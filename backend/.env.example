# Sponsor Spotlight — local configuration
#
#   cd backend && cp .env.example .env
#
# Loaded by core/env.py. Real exported environment variables always win over
# this file. On Vercel there is no .env — set these as project env vars instead.


# ── Required ──────────────────────────────────────────────────────────────────

# Your TwelveLabs API key. Jockey (jockey1.0) is in beta and needs an
# allowlisted key — https://twelvelabs.io
#
# Used by the offline scripts (pre_processing/), and — when set on a running
# server — it also switches on the locked "Demo" tab, which spends this key on
# behalf of every visitor. Leave it UNSET to ship "Use your own key" mode only,
# where each user pastes their own key in the browser.
TWELVELABS_API_KEY=


# ── Demo collection (optional) ────────────────────────────────────────────────
# Defaults point at our pre-indexed Premier League collection, which your key
# cannot read. Set these to your own knowledge store to run the demo tab on your
# own footage — but see the warning below first.

# Knowledge store the Demo tab is pinned to.
# SPONSOR_SPOTLIGHT_STORE_ID=ks_...

# Display name for that collection in the UI.
# SPONSOR_SPOTLIGHT_STORE_NAME=My Broadcasts

# Sport profile driving prompts + enrichment vocabulary (see backend/sports.py).
# SPONSOR_SPOTLIGHT_SPORT=soccer

# Brands the Demo tab pre-selects and auto-runs. Must exist in the committed
# demo_fixtures/, or the request falls through to a live Jockey call.
# SPONSOR_SPOTLIGHT_DEMO_BRANDS=Etihad,Emirates

# ⚠️  Pointing SPONSOR_SPOTLIGHT_STORE_ID at your own store does NOT currently
#     make the Demo tab analyze your footage. The committed fixtures in
#     backend/demo_fixtures/ are keyed by endpoint + brands + game id, NOT by
#     store — so they are served regardless of which store is configured, and
#     the game roster in backend/games.py is hardcoded to our five asset ids.
#     Until that is fixed (CWORK-1099), use "Use your own key" mode, or append
#     ?live=1 to force a real Jockey run.


# ── Highlight reels (optional) ────────────────────────────────────────────────
# Only needed to run pre_processing/build_reels.py. Requires FFmpeg on PATH.

# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...


# ── Offline capture knobs (optional) ──────────────────────────────────────────
# See pre_processing/capture_demo_cache.py and build_reels.py for the full set.

# SPONSOR_SPOTLIGHT_CAPTURE_GAMES=aggregate,mci-liv-2019
# SPONSOR_SPOTLIGHT_CAPTURE_BRANDS=Etihad,Emirates
# SPONSOR_SPOTLIGHT_CAPTURE_DELAY=30      # seconds between calls (~2 req/min)
# SPONSOR_SPOTLIGHT_ANALYZE_TOPN=8
# SPONSOR_SPOTLIGHT_LEGIBILITY_TOPN=8
# SPONSOR_SPOTLIGHT_CAPTURE_FORCE=1       # re-capture everything from scratch
