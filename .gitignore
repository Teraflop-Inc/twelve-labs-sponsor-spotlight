# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node (see also frontend/.gitignore)
node_modules/
*.tsbuildinfo
.vite/

# Logs & local env
*.log
.env
.env.local
.env.*.local
!.env.example

# Ingest manifest (asset_id → knowledge-store item_id); regenerated by
# pre_processing.ingest_assets, machine-specific.
backend/iconik_ingest.json

# Internal working notes live in workspace/ and are never committed — this repo
# is published alongside the Jockey tutorial, so meeting summaries, customer
# plans, partner updates and QC/accuracy measurements all belong in there
# rather than at the repo root.
/workspace/
/.fabric/

# OS
.DS_Store
Thumbs.db

# Built frontend bundle — Vercel builds it at deploy time (see vercel.json
# buildCommand). Never commit it; a stale committed bundle silently shadows
# your source changes.
backend/webapp/
